# Ambiente
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://evolvi:evolvi_secret@localhost:5432/evolvi_db?schema=public

# Autenticação & Segurança
JWT_SECRET=super_secret_jwt_key_troque_em_producao_123456789
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Open Finance Brasil (TASK-31)
# Modo de Operação: 'mock' (dados simulados para testes) ou 'real' (APIs reais / agregador)
OPEN_FINANCE_MODE=mock
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_API_URL=
