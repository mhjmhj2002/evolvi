# Ambiente
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://evolvi:evolvi_secret@localhost:5432/evolvi_db?schema=public

# Autenticação & Segurança
JWT_SECRET=super_secret_jwt_key_troque_em_producao_123456789
JWT_EXPIRES_IN=24h
# Chave mestra para criptografia AES-256-GCM de credenciais sensíveis no banco (mínimo 32 caracteres)
ENCRYPTION_KEY=evolvi_master_encryption_key_32_bytes_seguranca_total_2026!

# CORS
CORS_ORIGIN=http://localhost:5173

# Open Finance Brasil (TASK-31)
# Modo de Operação: 'mock' (dados simulados para testes) ou 'real' (APIs reais / agregador)
OPEN_FINANCE_MODE=mock
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_API_URL=
 
# Detecção de Duplicatas (Limiar de similaridade de nome para suspeita: 0.0 a 1.0, padrão 0.5 = 50%)
DUPLICATA_SIMILARIDADE_MINIMA=0.5

# TASK-49 — Cotação USD→BRL usada no cálculo de custo das chamadas de IA (padrão 5.5)
COTACAO_USD_BRL=5.5

# OpenRouter — provedor multi-modelo (chat completions compatível com OpenAI)
# Chave de servidor (opcional): fallback quando o usuário não tem chave salva (paridade com GEMINI_API_KEY)
OPENROUTER_API_KEY=
# URL base da API (padrão: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Header HTTP-Referer para atribuição no ranking do OpenRouter (padrão: CORS_ORIGIN ou http://localhost:5173)
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# Header X-Title (nome do app exibido no OpenRouter; padrão: Evolvi Financeiro)
# OPENROUTER_X_TITLE=Evolvi Financeiro

# Armazenamento de Uploads

# Diretório base dos uploads (padrão relativo à raiz do projeto).
# Em produção aponte para fora do projeto (ex.: UPLOADS_DIR=/var/lib/evolvi/uploads).
# Cada usuário tem subpasta própria (UPLOADS_DIR/<usuarioId>/...).
UPLOADS_DIR=uploads
