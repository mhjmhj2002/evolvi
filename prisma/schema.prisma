generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoConta {
  CONTA_CORRENTE
  CARTAO_CREDITO
  INVESTIMENTO
  CARTEIRA_DINHEIRO

  @@map("tipo_conta")
}

enum NaturezaMovimento {
  RECEITA
  DESPESA
  TRANSFERENCIA_PROPRIA
  APORTE_PATRIMONIAL

  @@map("natureza_movimento")
}

enum StatusMovimento {
  PREVISTO
  CONCILIADO
  CANCELADO

  @@map("status_movimento")
}

enum StatusParcelamento {
  ATIVO
  QUITADO
  CANCELADO

  @@map("status_parcelamento")
}

enum StatusRecorrencia {
  ATIVA
  PAUSADA
  CANCELADA

  @@map("status_recorrencia")
}

enum SemaforoStatus {
  VERDE
  AMARELO
  VERMELHO

  @@map("semaforo_status")
}

enum RoleUsuario {
  OWNER
  ADMIN
  USER
  VISITANTE

  @@map("role_usuario")
}

model Usuario {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String      @db.VarChar(120)
  email            String      @unique @db.VarChar(180)
  senhaHash        String      @map("senha_hash") @db.VarChar(255)
  role             RoleUsuario @default(USER)
  rendaBaseMensal  Decimal     @default(0.00) @map("renda_base_mensal") @db.Decimal(12, 2)
  faseAtual        Int         @default(1) @map("fase_atual")
  versaoRegrasMovimentos Int   @default(1) @map("versao_regras_movimentos")
  criadoEm         DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime    @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  contas           Conta[]
  categorias       Categoria[]
  movimentos       Movimento[]
  recorrencias     Recorrencia[]
  parcelamentos    Parcelamento[]
  metasZeroAZero   MetaZeroAZero[]
  conexoesBancarias ConexaoBancaria[]
  configuracao     ConfiguracaoUsuario?
  configuracoesIa  ConfiguracaoIaUsuario[]
  dadosBrutosOpenFinance DadoBrutoOpenFinance[]
  lotesImportacao  LoteImportacao[]
  historicoImportacaoArquivos HistoricoImportacaoArquivo[]
  alertasConciliacao AlertaConciliacao[]

  @@map("usuarios")
}

model ConfiguracaoIaUsuario {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId            String   @map("usuario_id") @db.Uuid
  provedor             String   @default("GEMINI") @db.VarChar(30)
  modelo               String   @default("gemini-3.8-flash") @db.VarChar(60)
  apiKeyCifrada        String   @map("api_key_cifrada") @db.Text
  ivHex                String   @map("iv_hex") @db.VarChar(32)
  tagHex               String   @map("tag_hex") @db.VarChar(40)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario              Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, provedor], map: "uq_configuracao_ia_usuario_provedor")
  @@index([usuarioId], map: "idx_configuracao_ia_usuario")
  @@map("configuracoes_ia_usuario")
}

model ConfiguracaoUsuario {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId                  String   @unique @map("usuario_id") @db.Uuid
  mesesJanelaTemporal        Int      @default(6) @map("meses_janela_temporal")
  intervaloSincronizacaoHoras Int      @default(6) @map("intervalo_sincronizacao_horas")
  criadoEm                   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm               DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario                    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("configuracoes_usuario")
}

model Conta {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String    @map("usuario_id") @db.Uuid
  nome                String    @db.VarChar(100)
  tipo                TipoConta
  diaFechamento       Int?      @map("dia_fechamento")
  diaVencimento       Int?      @map("dia_vencimento")
  saldoInicial        Decimal   @default(0.00) @map("saldo_inicial") @db.Decimal(12, 2)
  ativo               Boolean   @default(true)
  monitorarConciliacao Boolean  @default(true) @map("monitorar_conciliacao")
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimentos          Movimento[]
  parcelamentos       Parcelamento[]
  historicoArquivos   HistoricoImportacaoArquivo[]
  alertasConciliacao  AlertaConciliacao[]

  @@index([usuarioId], map: "idx_contas_usuario")
  @@map("contas")
}

model Categoria {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId               String?   @map("usuario_id") @db.Uuid
  nome                    String    @db.VarChar(80)
  descricao               String?   @db.VarChar(255)
  categoriaPaiId          String?   @map("categoria_pai_id") @db.Uuid
  pesoBrutoReferencia     Decimal?  @default(0.0000) @map("peso_bruto_referencia") @db.Decimal(6, 4)
  referenciaNormalizadaPct Decimal? @default(0.00) @map("referencia_normalizada_pct") @db.Decimal(5, 2)
  ordem                   Int?      @default(0)
  criadoEm                DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario                 Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoriaPai            Categoria? @relation("CategoriaFilhas", fields: [categoriaPaiId], references: [id], onDelete: Restrict)
  subcategorias           Categoria[] @relation("CategoriaFilhas")
  movimentos              Movimento[]
  rateios                 MovimentoRateio[]
  recorrencias            Recorrencia[]
  parcelamentos           Parcelamento[]
  metasZeroAZero          MetaZeroAZero[]

  @@index([usuarioId], map: "idx_categorias_usuario")
  @@map("categorias")
}

model Movimento {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId              String             @map("usuario_id") @db.Uuid
  contaId                String             @map("conta_id") @db.Uuid
  categoriaId            String?            @map("categoria_id") @db.Uuid
  dataMovimento          DateTime           @map("data_movimento") @db.Date
  competencia            String             @db.VarChar(7)
  descricao              String             @db.VarChar(255)
  valor                  Decimal            @db.Decimal(12, 2)
  natureza               NaturezaMovimento
  status                 StatusMovimento    @default(CONCILIADO)
  chaveDedupe            String?            @map("chave_dedupe") @db.VarChar(255)
  idOrigem               String?            @map("id_origem") @db.VarChar(255)
  transferenciaVinculoId String?            @map("transferencia_vinculo_id") @db.Uuid
  observacao             String?            @db.Text
  origemDocumento        String?            @map("origem_documento") @db.VarChar(255)
  categoriaFixadaPeloUsuario Boolean        @default(false) @map("categoria_fixada_usuario")
  criadoEm               DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario                Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conta                  Conta              @relation(fields: [contaId], references: [id], onDelete: Restrict)
  categoria              Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  transferenciaVinculo   Movimento?         @relation("TransferenciaRel", fields: [transferenciaVinculoId], references: [id], onDelete: SetNull)
  movimentosVinculados   Movimento[]        @relation("TransferenciaRel")
  rateios                MovimentoRateio[]

  @@unique([usuarioId, chaveDedupe], map: "uq_movimentos_usuario_chave_dedupe")
  @@index([usuarioId, competencia], map: "idx_movimentos_usuario_competencia")
  @@index([chaveDedupe], map: "idx_movimentos_chave_dedupe")
  @@index([categoriaId], map: "idx_movimentos_categoria")
  @@index([usuarioId, categoriaFixadaPeloUsuario], map: "idx_movimentos_usuario_fixada")
  @@map("movimentos")
}

model MovimentoRateio {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movimentoId  String    @map("movimento_id") @db.Uuid
  categoriaId  String    @map("categoria_id") @db.Uuid
  valor        Decimal   @db.Decimal(12, 2)
  descricao    String?   @db.VarChar(255)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  movimento    Movimento @relation(fields: [movimentoId], references: [id], onDelete: Cascade)
  categoria    Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([movimentoId], map: "idx_movimentos_rateio_movimento")
  @@index([categoriaId], map: "idx_movimentos_rateio_categoria")
  @@map("movimentos_rateio")
}

model Recorrencia {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId       String             @map("usuario_id") @db.Uuid
  categoriaId     String?            @map("categoria_id") @db.Uuid
  descricao       String             @db.VarChar(150)
  valorReferencia Decimal            @map("valor_referencia") @db.Decimal(12, 2)
  diaPrevisto     Int?               @map("dia_previsto")
  formaPagamento  String?            @map("forma_pagamento") @db.VarChar(50)
  essencial       Boolean            @default(true)
  status          StatusRecorrencia  @default(ATIVA)
  criadoEm        DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario         Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria       Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([usuarioId], map: "idx_recorrencias_usuario")
  @@map("recorrencias")
}

model Parcelamento {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId         String             @map("usuario_id") @db.Uuid
  contaId           String?            @map("conta_id") @db.Uuid
  categoriaId       String?            @map("categoria_id") @db.Uuid
  descricao         String             @db.VarChar(150)
  valorTotal        Decimal            @map("valor_total") @db.Decimal(12, 2)
  parcelaValor      Decimal            @map("parcela_valor") @db.Decimal(12, 2)
  parcelaAtual      Int                @map("parcela_atual")
  totalParcelas     Int                @map("total_parcelas")
  primeiroVencimento String            @map("primeiro_vencimento") @db.VarChar(7)
  ultimoVencimento  String             @map("ultimo_vencimento") @db.VarChar(7)
  status            StatusParcelamento @default(ATIVO)
  criadoEm          DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conta             Conta?             @relation(fields: [contaId], references: [id], onDelete: Restrict)
  categoria         Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([usuarioId], map: "idx_parcelamentos_usuario")
  @@map("parcelamentos")
}

model MetaZeroAZero {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId       String         @map("usuario_id") @db.Uuid
  categoriaId     String         @map("categoria_id") @db.Uuid
  competencia     String         @db.VarChar(7)
  baselineMensal  Decimal        @default(0.00) @map("baseline_mensal") @db.Decimal(12, 2)
  metaProposta    Decimal        @map("meta_proposta") @db.Decimal(12, 2)
  reducaoProposta Decimal        @default(0.00) @map("reducao_proposta") @db.Decimal(12, 2)
  condicaoAcao    String?        @map("condicao_acao") @db.Text
  statusSemaforo  SemaforoStatus @map("status_semaforo")
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario         Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria       Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, categoriaId, competencia], map: "uq_meta_usuario_categoria_competencia")
  @@index([usuarioId, competencia], map: "idx_metas_usuario_comp")
  @@map("metas_zero_a_zero")
}

enum StatusConexaoBancaria {
  CONECTADO
  EXPIRADO
  ERRO_AUTENTICACAO
  REVOGADO

  @@map("status_conexao_bancaria")
}

model ConexaoBancaria {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId             String                @map("usuario_id") @db.Uuid
  instituicaoCodigo     String                @map("instituicao_codigo") @db.VarChar(20)
  instituicaoNome       String                @map("instituicao_nome") @db.VarChar(100)
  compe                 String?               @db.VarChar(10)
  status                StatusConexaoBancaria @default(CONECTADO)
  consentimentoId       String?               @map("consentimento_id") @db.VarChar(255)
  consentimentoExpiraEm DateTime?             @map("consentimento_expira_em") @db.Timestamptz(6)
  ultimaSincronizacaoEm DateTime?             @map("ultima_sincronizacao_em") @db.Timestamptz(6)
  mensagemErro          String?               @map("mensagem_erro") @db.Text
  parametrosExtras      String?               @map("parametros_extras") @db.Text
  criadoEm              DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm          DateTime              @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario               Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dadosBrutos           DadoBrutoOpenFinance[]

  @@index([usuarioId], map: "idx_conexoes_usuario")
  @@index([instituicaoCodigo], map: "idx_conexoes_instituicao")
  @@map("conexoes_bancarias")
}

enum TipoDadoBruto {
  TRANSACOES
  FATURAS
  CONTAS
  SALDOS

  @@map("tipo_dado_bruto")
}

enum StatusDadoBruto {
  PENDENTE_PROCESSAMENTO
  PROCESSANDO
  PROCESSADO
  ERRO_PROCESSAMENTO

  @@map("status_dado_bruto")
}

model DadoBrutoOpenFinance {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId         String          @map("usuario_id") @db.Uuid
  conexaoId         String          @map("conexao_id") @db.Uuid
  instituicaoCodigo String          @map("instituicao_codigo") @db.VarChar(20)
  tipoDado          TipoDadoBruto   @map("tipo_dado")
  payloadRaw        Json            @map("payload_raw")
  hashCarga         String          @map("hash_carga") @db.VarChar(64)
  status            StatusDadoBruto @default(PENDENTE_PROCESSAMENTO)
  mensagemErro      String?         @map("mensagem_erro") @db.Text
  tentativas        Int             @default(0)
  coletadoEm        DateTime        @default(now()) @map("coletado_em") @db.Timestamptz(6)
  processadoEm      DateTime?       @map("processado_em") @db.Timestamptz(6)

  usuario           Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conexao           ConexaoBancaria @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  @@unique([conexaoId, hashCarga], map: "uq_dados_brutos_conexao_hash")
  @@index([usuarioId, status], map: "idx_dados_brutos_usuario_status")
  @@index([conexaoId, coletadoEm], map: "idx_dados_brutos_conexao_coletado")
  @@map("dados_brutos_open_finance")
}

enum StatusLoteImportacao {
  RECEPCIONADO
  PROCESSANDO_IA
  CARGA_STAGING
  CONSOLIDANDO
  CONCLUIDO
  ERRO_PARCIAL
  ERRO_TOTAL

  @@map("status_lote_importacao")
}

enum StatusArquivoImportacao {
  RECEPCIONADO
  ENVIADO_IA
  IA_CONCLUIDO
  STAGING_CARREGADO
  PROCESSADO_FINAL
  ERRO

  @@map("status_arquivo_importacao")
}

enum StatusStagingLancamento {
  PENDENTE
  PROCESSADO
  IGNORADO
  ERRO

  @@map("status_staging_lancamento")
}

model LoteImportacao {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String               @map("usuario_id") @db.Uuid
  caminhoDiretorio    String               @map("caminho_diretorio") @db.VarChar(500)
  totalArquivos       Int                  @default(0) @map("total_arquivos")
  arquivosProcessados Int                  @default(0) @map("arquivos_processados")
  status              StatusLoteImportacao @default(RECEPCIONADO)
  criadoEm            DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime             @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario             Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  arquivos            ArquivoImportacao[]
  stagingLancamentos  StagingLancamentoImportacao[]

  @@index([usuarioId, status], map: "idx_lotes_usuario_status")
  @@map("lotes_importacao")
}

model ArquivoImportacao {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loteId              String                  @map("lote_id") @db.Uuid
  nomeArquivo         String                  @map("nome_arquivo") @db.VarChar(255)
  tamanhoBytes        BigInt                  @default(0) @map("tamanho_bytes")
  mimeType            String?                 @map("mime_type") @db.VarChar(100)
  caminhoRelativo     String                  @map("caminho_relativo") @db.VarChar(500)
  status              StatusArquivoImportacao @default(RECEPCIONADO)
  mensagemErro        String?                 @map("mensagem_erro") @db.Text
  criadoEm            DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime                @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  lote                LoteImportacao          @relation(fields: [loteId], references: [id], onDelete: Cascade)
  stagingLancamentos  StagingLancamentoImportacao[]
  historico           HistoricoImportacaoArquivo?

  @@index([loteId, status], map: "idx_arquivos_lote_status")
  @@map("arquivos_importacao")
}

model StagingLancamentoImportacao {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loteId               String                  @map("lote_id") @db.Uuid
  arquivoId            String                  @map("arquivo_id") @db.Uuid
  arquivoOrigem        String                  @map("arquivo_origem") @db.VarChar(255)
  dataMovimento        DateTime                @map("data_movimento") @db.Date
  descricao            String                  @db.VarChar(255)
  valor                Decimal                 @db.Decimal(12, 2)
  natureza             NaturezaMovimento
  contaSugerida        String?                 @map("conta_sugerida") @db.VarChar(100)
  tipoConta            TipoConta?              @map("tipo_conta")
  categoriaSugerida    String?                 @map("categoria_sugerida") @db.VarChar(100)
  parcelaAtual         Int?                    @map("parcela_atual")
  totalParcelas        Int?                    @map("total_parcelas")
  idOrigem             String?                 @map("id_origem") @db.VarChar(255)
  observacao           String?                 @db.Text
  statusProcessamento  StatusStagingLancamento @default(PENDENTE) @map("status_processamento")
  criadoEm             DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)

  lote                 LoteImportacao          @relation(fields: [loteId], references: [id], onDelete: Cascade)
  arquivo              ArquivoImportacao       @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  @@index([loteId, statusProcessamento], map: "idx_staging_lote_status")
  @@index([arquivoId], map: "idx_staging_arquivo")
  @@map("staging_lancamentos_importacao")
}

enum TipoDocumentoImportado {
  FATURA_CARTAO
  EXTRATO_CONTA_CORRENTE
  EXTRATO_INVESTIMENTO
  OUTRO

  @@map("tipo_documento_importado")
}

enum TipoAlertaConciliacao {
  FATURA_NAO_IMPORTADA
  EXTRATO_LACUNA_TEMPORAL
  CONFLITO_SALDO

  @@map("tipo_alerta_conciliacao")
}

enum StatusAlertaConciliacao {
  PENDENTE
  RESOLVIDO
  DISPENSADO

  @@map("status_alerta_conciliacao")
}

model HistoricoImportacaoArquivo {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String                 @map("usuario_id") @db.Uuid
  arquivoId        String                 @unique @map("arquivo_id") @db.Uuid
  contaId          String?                @map("conta_id") @db.Uuid
  tipoDocumento    TipoDocumentoImportado @default(OUTRO) @map("tipo_documento")
  instituicao      String                 @db.VarChar(100)
  competencia      String                 @db.VarChar(7)
  dataVencimento   DateTime?              @map("data_vencimento") @db.Date
  periodoInicio    DateTime?              @map("periodo_inicio") @db.Date
  periodoFim       DateTime?              @map("periodo_fim") @db.Date
  totalTransacoes  Int                    @default(0) @map("total_transacoes")
  valorTotal       Decimal                @default(0.00) @map("valor_total") @db.Decimal(12, 2)
  criadoEm         DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario          Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  arquivo          ArquivoImportacao      @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  conta            Conta?                 @relation(fields: [contaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, competencia], map: "idx_historico_importacao_usuario_comp")
  @@index([usuarioId, contaId], map: "idx_historico_importacao_usuario_conta")
  @@map("historico_importacao_arquivos")
}

model AlertaConciliacao {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String                  @map("usuario_id") @db.Uuid
  contaId        String?                 @map("conta_id") @db.Uuid
  tipoAlerta     TipoAlertaConciliacao   @map("tipo_alerta")
  titulo         String                  @db.VarChar(200)
  descricao      String                  @db.Text
  competencia    String                  @db.VarChar(7)
  status         StatusAlertaConciliacao @default(PENDENTE)
  motivoDispensa String?                 @map("motivo_dispensa") @db.VarChar(100)
  criadoEm       DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  resolvidoEm    DateTime?               @map("resolvido_em") @db.Timestamptz(6)

  usuario        Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conta          Conta?                  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, status], map: "idx_alertas_conciliacao_usuario_status")
  @@index([usuarioId, contaId, competencia], map: "idx_alertas_conciliacao_usuario_conta_comp")
  @@map("alertas_conciliacao")
}



