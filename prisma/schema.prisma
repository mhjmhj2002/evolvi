  EXTRACAO_EXTRATO
  CATEGORIZACAO
  RECLASSIFICACAO
  CHAT
  OUTROS

  @@map("funcionalidade_uso_ia")
}

enum StatusUsoIa {
  SUCESSO
  FALHA

  @@map("status_uso_ia")
}

model UsoIaLog {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String              @map("usuario_id") @db.Uuid
  funcionalidade FuncionalidadeUsoIa
  provedor       String              @db.VarChar(30)
  modelo         String              @db.VarChar(80)
  tokensPrompt   Int                 @default(0) @map("tokens_prompt")
  tokensResposta Int                 @default(0) @map("tokens_resposta")
